# Copy to .env for local development: cp .env.example .env
# In production these are set in Railway → your service → Variables.
# See EMAIL-SETUP.md for where each value comes from.

# Resend API key with "Sending access" only. Create at resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified in Resend, or every send is rejected.
MAIL_FROM=Sonchy <creative@xsonchy.com>

# Where replies land. creative@xsonchy.com has no mailbox behind it yet, so
# point this at an inbox that is actually read, or replies bounce.
MAIL_REPLY_TO=you@example.com

# Subject line of the mail. Optional; defaults to "Материалы от Sonchy".
MAIL_SUBJECT=Материалы от Sonchy

# Local only. Railway injects PORT itself — do NOT set it there.
PORT=3000
